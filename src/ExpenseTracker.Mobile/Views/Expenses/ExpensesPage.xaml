<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="ExpenseTracker.Mobile.Views.Expenses.ExpensesPage"
    Title="Gastos"
    BackgroundColor="#F3F4F6">

    <Grid RowDefinitions="Auto,*">

        <!-- HEADER -->

        <VerticalStackLayout
            Padding="20,20,20,10"
            Spacing="4">

            <Label
                Text="Mis Gastos"
                FontSize="32"
                FontAttributes="Bold"
                TextColor="#111827" />

            <Label
                Text="Controlá tus movimientos"
                FontSize="14"
                TextColor="#6B7280" />

        </VerticalStackLayout>

        <!-- LISTA -->

        <CollectionView
            Grid.Row="1"
            ItemsSource="{Binding Expenses}"
            Margin="0,10,0,0"
            SelectionMode="None">

            <CollectionView.EmptyView>

                <VerticalStackLayout
                    Padding="40"
                    Spacing="10"
                    VerticalOptions="Center">

                    <Label
                        Text="🧾"
                        FontSize="64"
                        HorizontalTextAlignment="Center" />

                    <Label
                        Text="No hay gastos cargados"
                        FontSize="20"
                        FontAttributes="Bold"
                        HorizontalTextAlignment="Center" />

                    <Label
                        Text="Agregá tu primer gasto"
                        FontSize="14"
                        TextColor="#6B7280"
                        HorizontalTextAlignment="Center" />

                </VerticalStackLayout>

            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>

                <DataTemplate>

                    <Border
                        Margin="16,8"
                        Padding="16"
                        BackgroundColor="White"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 20">

                        <Grid ColumnDefinitions="*,Auto">

                            <!-- INFO -->

                            <VerticalStackLayout
                                Spacing="6">

                                <Label
                                    Text="{Binding Description}"
                                    FontSize="18"
                                    FontAttributes="Bold"
                                    TextColor="#111827" />

                                <Label
                                    Text="{Binding Date, StringFormat='{}{0:dd/MM/yyyy HH:mm}'}"
                                    FontSize="13"
                                    TextColor="#6B7280" />

                            </VerticalStackLayout>

                            <!-- MONTO -->

                            <Label
                                Grid.Column="1"
                                Text="{Binding Amount, StringFormat='$ {0:N2}'}"
                                FontSize="20"
                                FontAttributes="Bold"
                                VerticalOptions="Center"
                                TextColor="#059669" />

                        </Grid>

                    </Border>

                </DataTemplate>

            </CollectionView.ItemTemplate>

        </CollectionView>

        <!-- FAB -->

        <Button
            Text="+"
            WidthRequest="64"
            HeightRequest="64"
            CornerRadius="32"
            FontSize="28"
            FontAttributes="Bold"
            BackgroundColor="#2563EB"
            TextColor="White"
            Command="{Binding GoToCreateExpenseCommand}"
            HorizontalOptions="End"
            VerticalOptions="End"
            Margin="24" >
            
            <Button.Shadow>
                <Shadow
                    Brush="Black"
                    Offset="0,4"
                    Radius="12"
                    Opacity="0.3" />
            </Button.Shadow>
        </Button>
    </Grid>
</ContentPage>
